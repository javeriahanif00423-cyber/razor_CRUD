@page "{id:int}"
@model books_management_system.Pages.DeleteModel

<h2>Delete Book</h2>

<p>Are you sure you want to delete this book?</p>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Books.title</dd>

    <dt class="col-sm-2">Author</dt>
    <dd class="col-sm-10">@Model.Books.author</dd>

    <dt class="col-sm-2">Publisher</dt>
    <dd class="col-sm-10">@Model.Books.publisher</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Books.status</dd>

    <dt class="col-sm-2">Category</dt>
    <dd class="col-sm-10">@Model.Books.category</dd>
</dl>

<form method="post" asp-route-id="@Model.Books.Id">
    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-page="/books/Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
